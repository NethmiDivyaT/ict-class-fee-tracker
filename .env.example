# Local development uses data/fees.db automatically (no env needed).
#
# For Vercel production, create a free Turso DB:
#   1. https://turso.tech
#   2. Create database
#   3. Copy URL + create a token
#
# Then set these in Vercel → Settings → Environment Variables:

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_token_here
